PORT=8080
APP_ENV=poc
BUILD_VERSION=0.1.0-poc

# PostgreSQL di VPS k3s (vps-malang.singapura-parore.ts.net / 100.125.74.50)
# Sesuaikan user, password, dan port (5432 atau NodePort k3s, mis. 30432) sesuai service DB di VPS
DATABASE_URL=postgres://gacha:gacha_poc_password@vps-malang.singapura-parore.ts.net:5432/gacha_poc?sslmode=disable

JWT_SECRET=poc-local-dev-secret-change-in-k3s-32bytes
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://macbook.singapura-parore.ts.net:8080,https://macbook.singapura-parore.ts.net,http://vps-malang.singapura-parore.ts.net:8080,https://gacha-poc.singapura-parore.ts.net

RATE_LIMIT_USER_PER_MIN=60
RATE_LIMIT_DEVICE_PER_MIN=90
DRAW_MIN_INTERVAL_MS=400
WEB_DIST_DIR=../web-gacha/dist
